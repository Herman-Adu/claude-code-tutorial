// Prisma schema for Kanban Board application
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Authentication Models (NextAuth.js / Auth.js)
// =============================================================================

/// User model for authentication and authorization.
/// Supports both OAuth and credentials-based authentication.
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  name          String?   @db.VarChar(100)
  image         String?   @db.Text
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  labels        Label[]
  filterPresets SavedFilterPreset[]
  notifications Notification[]
  comments      Comment[]  @relation("CommentAuthor")
  activities    Activity[] @relation("UserActivities")

  // Indexes for frequently queried fields
  @@index([email], name: "idx_user_email")
  @@index([createdAt], name: "idx_user_created_at")
  @@map("users")
}

/// Account model for OAuth provider accounts.
/// Links OAuth accounts (GitHub, Google, etc.) to users.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.Text
  id_token          String? @db.Text
  session_state     String? @db.Text

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint for provider + account ID combination
  @@unique([provider, providerAccountId])
  @@index([userId], name: "idx_account_user_id")
  @@map("accounts")
}

/// Session model for managing user sessions.
/// Used when database session strategy is enabled.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  expires      DateTime

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_session_user_id")
  @@index([expires], name: "idx_session_expires")
  @@map("sessions")
}

/// Verification token for email verification.
/// Used for passwordless sign-in and email verification flows.
model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// Application Models
// =============================================================================

// Priority levels for tasks
enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Column/status identifiers for the Kanban board
enum ColumnId {
  TODO
  IN_PROGRESS
  COMPLETED
}

/// Task model representing a single task on the Kanban board.
/// Each task belongs to a user (owner) and has a status, priority, and tags.
model Task {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(100)
  description String   @db.VarChar(500)
  priority    Priority @default(MEDIUM)
  tags        Json     @default("[]") @db.JsonB
  columnId    ColumnId @default(TODO)
  categories  Json     @default("[]") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Calendar fields (Sprint 3)
  dueDate  DateTime? @map("due_date")
  dueTime  String?   @map("due_time") @db.VarChar(5) // "HH:MM" format
  isAllDay Boolean   @default(true) @map("is_all_day")

  // Owner relationship - links task to a user
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Label relationship - many-to-many through TaskLabel junction
  labels TaskLabel[]

  // Comment and Activity relationships (Phase 2C)
  comments   Comment[]
  activities Activity[]

  // Notification relationship
  notifications Notification[]

  // Indexes for frequently queried fields
  @@index([columnId], name: "idx_task_column_id")
  @@index([priority], name: "idx_task_priority")
  @@index([createdAt], name: "idx_task_created_at")
  @@index([ownerId], name: "idx_task_owner_id")
  @@index([dueDate], name: "idx_task_due_date")
  @@map("tasks")
}

// =============================================================================
// Label Models (Phase 2A - Labels System)
// =============================================================================

/// Label model for categorizing tasks with color-coded labels.
/// Each user can create their own labels for organizing tasks.
model Label {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  color     String   @db.VarChar(20) // hex code or preset name
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tasks TaskLabel[]
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint: each user can have only one label with a given name
  @@unique([userId, name], name: "idx_label_user_name")
  @@index([userId], name: "idx_label_user_id")
  @@map("labels")
}

/// Junction table for many-to-many relationship between tasks and labels.
/// Enables a task to have multiple labels and a label to be used on multiple tasks.
model TaskLabel {
  taskId    String   @map("task_id") @db.Uuid
  labelId   String   @map("label_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  // Composite primary key
  @@id([taskId, labelId])
  @@index([taskId], name: "idx_task_label_task_id")
  @@index([labelId], name: "idx_task_label_label_id")
  @@map("task_labels")
}

// =============================================================================
// Saved Filter Presets (Phase 2B - Search & Filtering)
// =============================================================================

/// SavedFilterPreset model for storing user's saved filter configurations.
/// Allows users to save and quickly load frequently used filter combinations.
model SavedFilterPreset {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(50)
  filters   Json     @db.JsonB // FilterOptions JSON object
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint: each user can have only one preset with a given name
  @@unique([userId, name], name: "idx_filter_preset_user_name")
  @@index([userId], name: "idx_filter_preset_user_id")
  @@map("saved_filter_presets")
}

// =============================================================================
// Comments & Activity Models (Phase 2C - Comments & Activity System)
// =============================================================================

/// Activity types for tracking all changes to tasks.
/// Used for audit trail and activity feed.
enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_DELETED
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
  LABEL_ADDED
  LABEL_REMOVED
}

/// Comment model for task discussion.
/// Allows users to leave comments on tasks with edit tracking.
model Comment {
  id       String  @id @default(uuid()) @db.Uuid
  text     String  @db.Text
  taskId   String  @map("task_id") @db.Uuid
  authorId String  @map("author_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  editedAt  DateTime? @map("edited_at")

  // Relations
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId], name: "idx_comment_task_id")
  @@index([authorId], name: "idx_comment_author_id")
  @@index([createdAt], name: "idx_comment_created_at")
  @@map("comments")
}

/// Activity log for tracking all changes to tasks.
/// Provides audit trail and activity feed for collaborative features.
model Activity {
  id     String       @id @default(uuid()) @db.Uuid
  type   ActivityType
  taskId String       @map("task_id") @db.Uuid
  userId String       @map("user_id") @db.Uuid
  data   Json         @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId], name: "idx_activity_task_id")
  @@index([userId], name: "idx_activity_user_id")
  @@index([type], name: "idx_activity_type")
  @@index([createdAt], name: "idx_activity_created_at")
  @@map("activities")
}

// =============================================================================
// Notification Models (Phase 2D - Notifications System)
// =============================================================================

/// Event types that can trigger notifications
enum NotificationEventType {
  COMMENT_ADDED_TO_TASK
  TASK_MOVED_TO_COMPLETED
  TASK_MODIFIED
}

/// Notification model for Phase 2D.
/// Tracks which users have been notified of which events.
/// Soft-deleted via isRead flag for data retention.
model Notification {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  eventType NotificationEventType
  taskId    String?               @map("task_id") @db.Uuid

  // Notification state
  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  // Content
  title   String @db.VarChar(200)
  message String @db.VarChar(500)

  // Metadata
  data      Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_notification_user_id")
  @@index([isRead], name: "idx_notification_is_read")
  @@index([createdAt], name: "idx_notification_created_at")
  @@index([taskId], name: "idx_notification_task_id")
  @@index([userId, isRead, createdAt], name: "idx_notification_user_unread_created")
  @@index([userId, createdAt], name: "idx_notification_user_created")
  @@map("notifications")
}
