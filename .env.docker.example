# =============================================================================
# Docker Environment Variables
# Copy this file to .env for Docker deployments
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL superuser credentials
# IMPORTANT: Change these values in production!
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_secret

# Database name
POSTGRES_DB=kanban_db

# Port to expose PostgreSQL on host machine
# Default: 5434 (to avoid conflicts with local PostgreSQL on 5432)
# Note: In production, this is not used as the port is not exposed
POSTGRES_PORT=5434

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=production

# Port to expose the application on host machine
APP_PORT=3000

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------

# DATABASE_URL is automatically constructed in docker-compose.yml
# using the POSTGRES_* variables above.
#
# For local development (outside Docker), use:
# DATABASE_URL=postgresql://kanban:kanban_secret@localhost:5434/kanban_db?schema=public
#
# Inside Docker containers, the URL uses the service name 'postgres':
# DATABASE_URL=postgresql://kanban:kanban_secret@postgres:5432/kanban_db?schema=public

# -----------------------------------------------------------------------------
# Optional: Production-specific Settings
# -----------------------------------------------------------------------------

# Enable production logging (set to 'true' in production)
# ENABLE_PRODUCTION_LOGGING=false

# Application URL (for CORS, redirects, etc.)
# APP_URL=https://your-domain.com

# Secret key for session/JWT (generate a secure random string)
# SECRET_KEY=your-super-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Optional: Monitoring and Debugging
# -----------------------------------------------------------------------------

# Enable Prisma query logging (verbose in development)
# DEBUG=prisma:*

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
