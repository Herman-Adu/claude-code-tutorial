# Environment Variables for Kanban Board Application
# Copy this file to .env and fill in your values
#
# =============================================================================
# SECURITY WARNING
# =============================================================================
# NEVER commit real credentials or secrets to version control!
# This file contains EXAMPLE values only. Replace all placeholders with your
# actual values in your local .env file (which should be in .gitignore).
#
# For production deployments:
# - Use environment variables from your hosting provider's secrets management
# - Generate cryptographically secure secrets (e.g., openssl rand -base64 32)
# - Never reuse secrets across environments
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection string for Prisma ORM
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Replace with your actual database credentials
DATABASE_URL="postgresql://your_user:your_password@localhost:5432/your_database?schema=public"

# =============================================================================
# Docker PostgreSQL Configuration
# These variables are used by docker-compose.yml
# =============================================================================

# PostgreSQL superuser credentials - CHANGE THESE IN PRODUCTION
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password_here

# Database name to create
POSTGRES_DB=kanban_db

# Port to expose PostgreSQL on (default: 5434 to avoid conflicts with local PostgreSQL)
POSTGRES_PORT=5434

# =============================================================================
# Authentication Configuration (NextAuth.js / Auth.js)
# =============================================================================

# Base URL for NextAuth.js - must match your deployment URL
# In development, this is typically http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Secret key for encrypting JWT tokens and session cookies
# Generate with: openssl rand -base64 32
# IMPORTANT: Use a secure, randomly generated value in production
# REQUIRED: Must be at least 32 characters long
# WARNING: Never use the example value below - generate your own!
NEXTAUTH_SECRET=replace-this-with-a-secure-random-string-min-32-chars

# =============================================================================
# OAuth Provider: GitHub (Optional)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Leave blank or remove if not using GitHub authentication
# =============================================================================

# GitHub OAuth Client ID
GITHUB_ID=

# GitHub OAuth Client Secret
GITHUB_SECRET=

# =============================================================================
# OAuth Provider: Google (Optional)
# Create a Google OAuth App at: https://console.cloud.google.com/apis/credentials
# Leave blank or remove if not using Google authentication
# =============================================================================

# Google OAuth Client ID
GOOGLE_ID=

# Google OAuth Client Secret
GOOGLE_SECRET=

# =============================================================================
# Application Configuration (for future use)
# =============================================================================

# Node environment: development, production, test
# NODE_ENV=development

# Application port (if using custom server)
# PORT=3000
